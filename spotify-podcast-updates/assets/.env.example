# Spotify API credentials
# Get these from https://developer.spotify.com/dashboard

# Your Spotify app's Client ID (found on the app dashboard)
SPOTIFY_CLIENT_ID=your_client_id_here

# Your Spotify app's Client Secret (found on the app dashboard)
SPOTIFY_CLIENT_SECRET=your_client_secret_here

# A long-lived refresh token with user-library-read scope.
# To obtain one:
#   1. Go to https://developer.spotify.com/dashboard and create an app
#   2. Add http://localhost:8888/callback as a Redirect URI in the app settings
#   3. Open this URL in your browser (replace CLIENT_ID):
#      https://accounts.spotify.com/authorize?client_id=CLIENT_ID&response_type=code&redirect_uri=http://localhost:8888/callback&scope=user-library-read
#   4. After authorizing, copy the `code` query parameter from the redirect URL
#   5. Exchange it for tokens with:
#      curl -X POST https://accounts.spotify.com/api/token \
#        -u CLIENT_ID:CLIENT_SECRET \
#        -d grant_type=authorization_code \
#        -d code=CODE \
#        -d redirect_uri=http://localhost:8888/callback
#   6. Save the `refresh_token` value from the response below
SPOTIFY_REFRESH_TOKEN=your_refresh_token_here
